# Copy to .env and fill in. NEVER commit .env.
# Every value here is a placeholder — no real credential belongs in this file.

# ---------- Environment ----------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# ---------- Database ----------
# Must point at a PostgreSQL with the pgvector extension available.
# Matches the docker-compose.yml service defaults.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/aisep

# ---------- Redis / job queue ----------
REDIS_URL=redis://localhost:6379/0

# ---------- GitHub OAuth ----------
# From your registered GitHub OAuth App (https://github.com/settings/developers).
# The backend owns the OAuth flow (docs/adr/ADR-009), so the Authorization
# callback URL registered with GitHub must be exactly:
#     http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---------- Auth / session ----------
# Signs the session cookie the backend issues. Minimum 32 characters; the
# application refuses to start signing sessions with anything shorter.
# Generate with: openssl rand -base64 32
# Also accepted as SESSION_SECRET.
NEXTAUTH_SECRET=replace_with_a_random_32_byte_base64_string

# Key used to encrypt stored GitHub access tokens at rest. Minimum 32
# characters. Rotating it invalidates every stored token: users sign in again.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_a_random_32_byte_base64_string

# ---------- Ingestion ----------
# Extra directory names excluded from indexing, comma-separated. Empty by
# default: a name that is benchmark scaffolding in one repository is ordinary
# source in another, so excluding it globally would shrink an index for a
# reason nobody could see.
# Set to "eval" before running the *agent* benchmark against this repository,
# or it retrieves its own scaffolding. Leave it empty for the *retrieval*
# benchmark, which has a held-out label pointing into eval/ and refuses to run
# when that file is missing. The two cannot both hold on one index.
EXTRA_EXCLUDED_DIRECTORIES=

# ---------- Events and queue (ADR-003, ADR-004) ----------
# Where indexing events go. "inprocess" fans out synchronously inside the
# worker and needs nothing running; "kafka" publishes to a durable log that
# independent consumer groups read at their own pace.
EVENT_BACKEND=inprocess

# Which backend dispatches indexing work. Redis/RQ is the default: ADR-004
# scopes Kafka to events, and RQ gives per-job retry and failure visibility a
# log does not. "kafka" exists to demonstrate the ADR-003 interface is a real
# seam. Agent runs stay on RQ either way.
QUEUE_BACKEND=rq

# Kafka is not started by default -- it is profile-gated in docker-compose
# because it does not earn its memory on a development machine all day:
#     docker compose --profile kafka up -d
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- LLM provider ----------
# ollama | gemini. Selects what answers chat and drives the agent.
#
# Embeddings are deliberately unaffected and stay on Ollama: every stored vector
# records the model that produced it, and vectors from different models are not
# comparable, so switching embedding provider means re-embedding the corpus as a
# separate deliberate act (ADR-013).
LLM_PROVIDER=ollama

# Required only when LLM_PROVIDER=gemini. From https://aistudio.google.com/apikey
# Sent as a request header, never in a URL, so it cannot leak through proxy logs
# or the text of a timeout exception. Treated like GITHUB_CLIENT_SECRET: never
# logged, never returned by any endpoint.
GEMINI_API_KEY=
# The free tier allows 20 requests per day per project *per model*, so the
# allowance follows the model rather than the key: rotating a key buys back no
# quota, switching model does. Enough for interactive chat, far too little for
# the agent benchmark, which needs 30-70 calls for one sweep.
GEMINI_MODEL=gemini-3.6-flash

# ---------- LLM (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
# Generation and embedding models are configured independently on purpose.
#
# 3b is what this project is developed and benchmarked against, because 7b does
# not fit in 7.7 GB of RAM. It is a real constraint on the results rather than a
# preference: docs/README.md records that milestones 7 and 9 are partial because
# of model capability, and the recorded agent baseline is a 3b baseline.
#
# 7b is the better model and a machine with the memory should use it. Changing
# this invalidates the saved benchmark numbers, which name the model they were
# measured with.
LLM_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text
# Must match the dimensionality of EMBEDDING_MODEL (nomic-embed-text = 768).
EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=120

# ---------- URLs ----------
# Where the backend sends the browser after sign-in, and the single origin
# allowed to make credentialed cross-origin calls to the API.
FRONTEND_URL=http://localhost:3000
# Public base URL of the API. The GitHub callback URL is derived from it, so it
# must match the OAuth App registration exactly.
BACKEND_URL=http://localhost:8000
# The same API URL as the browser must see it (used for the sign-in link).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
