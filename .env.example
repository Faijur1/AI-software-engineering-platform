# Copy to .env and fill in. NEVER commit .env.
# Every value here is a placeholder — no real credential belongs in this file.

# ---------- Environment ----------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# ---------- Database ----------
# Must point at a PostgreSQL with the pgvector extension available.
# Matches the docker-compose.yml service defaults.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/aisep

# ---------- Redis / job queue ----------
REDIS_URL=redis://localhost:6379/0

# ---------- GitHub OAuth ----------
# From your registered GitHub OAuth App.
# Callback URL must be http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---------- Auth / session ----------
# Shared secret used by NextAuth to sign JWTs and by the backend to verify them.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_32_byte_base64_string
NEXTAUTH_URL=http://localhost:3000

# Key used to encrypt stored GitHub access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_a_random_32_byte_base64_string

# ---------- LLM (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
# Generation and embedding models are configured independently on purpose.
LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
# Must match the dimensionality of EMBEDDING_MODEL (nomic-embed-text = 768).
EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_SECONDS=120

# ---------- Frontend ----------
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
